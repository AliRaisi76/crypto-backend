# Copy to .env and adjust. Every value is optional; these are the defaults.

NODE_ENV=development          # development | test | production
PORT=4000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# How often price changes are pushed over Socket.IO (ms)
PUSH_INTERVAL_MS=1000

# How long a candle response is cached (ms)
CANDLE_TTL_MS=60000
